<Layouts.flash_group flash={@flash} />
<div class="min-h-[85vh] flex flex-col items-center justify-center px-4 py-12 text-center">
  <div class="max-w-2xl space-y-6 bg-slate-800/80 backdrop-blur-md p-8 sm:p-12 rounded-3xl border border-slate-700/60 shadow-2xl">
    <div class="mx-auto w-16 h-16 bg-indigo-500/10 rounded-2xl flex items-center justify-center text-indigo-400 border border-indigo-500/20 shadow-inner">
      <.icon name="hero-chat-bubble-bottom-center-text" class="w-8 h-8" />
    </div>

    <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight">
      Real-Time Anonymous Q&A Platform
    </h1>

    <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
      Frictionless, live audience interaction for town halls, conferences, and meetups. Join an active room with your event code or sign in as an admin.
    </p>

    <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
      <.link
        href={~p"/login"}
        class="w-full sm:w-auto px-8 py-3.5 rounded-xl font-bold text-white bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-600 hover:to-purple-700 shadow-lg shadow-indigo-500/25 transition-all duration-200"
      >
        Admin Portal Login
      </.link>

      <.link
        href={~p"/super-admin/setup"}
        class="w-full sm:w-auto px-8 py-3.5 rounded-xl font-bold text-amber-300 bg-amber-500/10 hover:bg-amber-500/20 border border-amber-500/30 transition-all duration-200"
      >
        Super Admin Setup
      </.link>
    </div>
  </div>
</div>
