<Layouts.flash_group flash={@flash} />
<div class="min-h-[85vh] flex flex-col items-center justify-center px-4 py-12 text-center">
  <div class="max-w-2xl space-y-6 bg-slate-800/80 backdrop-blur-md p-8 sm:p-12 rounded-3xl border border-slate-700/60 shadow-2xl">
    <div class="mx-auto w-16 h-16 bg-indigo-500/10 rounded-2xl flex items-center justify-center text-indigo-400 border border-indigo-500/20 shadow-inner">
      <.icon name="hero-chat-bubble-bottom-center-text" class="w-8 h-8" />
    </div>

    <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight">
      Real-Time Anonymous Q&A Platform
    </h1>

    <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
      Frictionless, live audience interaction for town halls, conferences, and meetups. Join an
      active room with the event code shared by its host.
    </p>
  </div>
</div>
