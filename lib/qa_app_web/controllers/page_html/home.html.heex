<QaAppWeb.Layouts.app flash={@flash}>
  <div class="max-w-6xl mx-auto px-6 pt-20 sm:pt-28 pb-24">
    <div class="grid grid-cols-12 gap-x-6">
      <div class="col-span-12 lg:col-span-8">
        <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-ink-3 flex items-center gap-2.5">
          <span class="w-2 h-2 bg-accent"></span> Town halls · Conferences · Meetups
        </p>

        <h1 class="mt-6 text-5xl sm:text-6xl lg:text-7xl font-semibold tracking-[-0.04em] leading-[1.02] text-ink">
          Real-Time Anonymous Q&amp;A<span class="text-accent">.</span>
        </h1>
      </div>

      <div class="col-span-12 lg:col-span-4 lg:col-start-9 mt-10 lg:mt-0 flex flex-col">
        <div class="order-1 lg:order-2 lg:mt-14 flex flex-col gap-6">
          <p class="text-[15px] leading-relaxed text-ink-2">
            Frictionless, live audience interaction for town halls, conferences, and meetups. Join an
            active room with the event code shared by its host.
          </p>

          <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-ink-3">
            One question per device
          </p>
        </div>

        <.meerkat class="order-2 lg:order-1 mt-14 lg:mt-0 w-[200px] sm:w-[240px] lg:w-[300px] self-end" />
      </div>
    </div>
  </div>
</QaAppWeb.Layouts.app>
